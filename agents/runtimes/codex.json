{
  "aliases": [],
  "enabledByDefault": true,
  "retired": false,
  "probeArgs": ["--skip-git-repo-check"],
  "promptArgs": [],
  "skills": {
    "discoveryDirs": [".agents/skills"]
  },
  "id": "codex",
  "name": "Codex",
  "evaluationOrder": 0,
  "commands": ["codex"],
  "auth": {
    "args": ["login", "status"],
    "parser": "login-status"
  },
  "models": {
    "args": ["debug", "models"],
    "parser": "codex-models"
  },
  "selectorArgs": ["exec", "-m", "{model}"],
  "permissions": {
    "flags": [
      "-s",
      "--sandbox",
      "-c",
      "--config",
      "-p",
      "--profile",
      "-P",
      "--permission-profile",
      "--add-dir",
      "--full-auto",
      "--approve-for-me",
      "--dangerously-bypass-approvals-and-sandbox",
      "--dangerously-bypass-hook-trust"
    ],
    "profiles": {
      "workspace-write": {
        "args": [],
        "enforcement": "inherited",
        "network": true
      },
      "worktree-setup": {
        "args": [],
        "enforcement": "inherited",
        "network": true
      },
      "read-only": {
        "args": ["-s", "read-only"],
        "enforcement": "cli",
        "network": false
      }
    }
  },
  "subagents": {
    "format": "agent-json",
    "directory": ".agents/agents",
    "models": {
      "reasoning": "inherit",
      "fast": "inherit"
    }
  },
  "usage": {
    "transport": "jsonrpc-stdio",
    "command": ["codex", "app-server"],
    "initialize": {
      "method": "initialize",
      "params": {
        "clientInfo": {
          "name": "issue-orchestrator",
          "version": "1"
        }
      }
    },
    "initialized": "initialized",
    "request": {
      "method": "account/rateLimits/read",
      "params": {
        "excludeResetCreditDetails": true
      }
    },
    "windows": "$.rateLimitsByLimitId.codex | $.rateLimits",
    "usedPercent": "usedPercent",
    "windowDurationMins": "windowDurationMins",
    "blocked": [
      "$.ordinaryUsageAllowed == false",
      "rateLimitReachedType != null"
    ]
  }
}
