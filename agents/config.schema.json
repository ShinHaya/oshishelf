{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseBranch": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "qualityGates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requirements": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "architecture": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "development": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "testing": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "security": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "githubOperations": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "manualTest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "uniqueItems": true
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "allow": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
                },
                "uniqueItems": true
              },
              "deny": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "permissions": {
          "type": "object",
          "properties": {
            "roles": {
              "type": "object",
              "properties": {
                "implementer": {
                  "enum": [
                    "workspace-write",
                    "worktree-setup",
                    "read-only",
                    "bypass"
                  ]
                },
                "planner": {
                  "enum": [
                    "workspace-write",
                    "worktree-setup",
                    "read-only",
                    "bypass"
                  ]
                },
                "reviewer": {
                  "enum": [
                    "workspace-write",
                    "worktree-setup",
                    "read-only",
                    "bypass"
                  ]
                }
              },
              "additionalProperties": false
            },
            "allowBypass": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "uniqueItems": true
            },
            "requireEnforcement": {
              "type": "array",
              "items": {
                "enum": ["workspace-write", "worktree-setup", "read-only"]
              },
              "uniqueItems": true
            },
            "runtimes": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "workspace-write": {
                    "type": "object",
                    "properties": {
                      "allow": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": ["allow"],
                    "additionalProperties": false
                  },
                  "worktree-setup": {
                    "type": "object",
                    "properties": {
                      "allow": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": ["allow"],
                    "additionalProperties": false
                  },
                  "read-only": {
                    "type": "object",
                    "properties": {
                      "allow": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": ["allow"],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inherit": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "uniqueItems": true
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "enterprise": {
      "type": "object",
      "properties": {
        "routeAttestation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "localSkills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "uniqueItems": true
    }
  },
  "required": [],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
