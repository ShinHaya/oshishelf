GOOGLE_CLOUD_PROJECT=oshishelf-hackathon
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
# Public origin of the app (used by the bookmarklet and Cloud Scheduler audience)
APP_ORIGIN=http://localhost:3000
# OIDC audience the scheduler uses (defaults to APP_ORIGIN/api/cron/watch)
CRON_AUDIENCE=
# Service account that Cloud Scheduler uses to call /api/cron/*
SCHEDULER_SA_EMAIL=
# Optional affiliate settings
AFFILIATE_DMM_ID=
AFFILIATE_AMAZON_TAG=
